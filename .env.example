# my.telegram.org → API development tools 에서 발급
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# 감시할 단체방: 채팅방 이름, ID(-100...), @username 중 하나. 여러 개면 쉼표로 구분
# `python telemsg.py chats` 로 ID를 확인할 수 있습니다.
CHATS=우리 단체방

# 보관할 사람: 숫자 ID 또는 @username. 여러 명이면 쉼표로 구분
# `python telemsg.py members "우리 단체방" 이름` 으로 ID를 확인할 수 있습니다.
USERS=123456789

# 복사본을 보낼 곳: me = 저장한 메시지. 비공개 채널을 만들었다면 그 채널 ID(-100...)
DEST=me

# 선택 설정
TIMEZONE=Asia/Seoul
SYNC_MINUTES=10     # 놓친 메시지·삭제 확인 주기(분)
BACKFILL=300        # 처음 실행할 때 훑어볼 최근 메시지 수
MAX_MEDIA_MB=50     # 이보다 큰 첨부파일은 내려받지 않음
DATA_DIR=data
